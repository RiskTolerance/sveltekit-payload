{
	"name": "sveltekit-payload",
	"private": true,
	"scripts": {
		"dev": "bun run --filter '*' dev",
		"dev:cms": "bun run --filter cms dev",
		"dev:web": "bun run --filter web dev",
		"build": "bun run --filter '*' build",
		"generate:types": "bun run --filter cms generate:types",
		"dc": "docker-compose",
		"dc:dev": "docker-compose -f docker-compose.dev.yml",
		"dc:up": "docker-compose up -d",
		"dc:down": "docker-compose down",
		"dc:dev:up": "docker-compose -f docker-compose.dev.yml up -d",
		"dc:dev:down": "docker-compose -f docker-compose.dev.yml down",
		"dc:restart:cms": "docker-compose -f docker-compose.dev.yml restart cms",
		"dc:restart:web": "docker-compose -f docker-compose.dev.yml restart web",
		"dc:logs": "docker-compose -f docker-compose.dev.yml logs -f",
		"dc:logs:cms": "docker-compose -f docker-compose.dev.yml logs -f cms",
		"dc:logs:web": "docker-compose -f docker-compose.dev.yml logs -f web",
		"migrate": "cd apps/cms && npx payload migrate",
		"migrate:create": "cd apps/cms && npx payload migrate:create"
	}
}
