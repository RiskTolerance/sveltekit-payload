{
  "name": "sveltekit-payload",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:cms": "bun run --filter cms dev",
    "dev:web": "bun run --filter web dev",
    "build": "bun run --filter '*' build",
    "generate:types": "bun run --filter cms generate:types"
  }
}