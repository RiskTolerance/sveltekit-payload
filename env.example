# .env.example
# Copy to .env and fill in values

# ============================================
# PostgreSQL (External - e.g., Coolify)
# ============================================
POSTGRES_USER=payload
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=payload
POSTGRES_PORT=5432

# DATABASE_URL for local development (required when running Payload commands locally)
# Use localhost for local development, host.docker.internal is only for Docker containers
DATABASE_URL=postgres://payload:change-me-in-production@localhost:5432/payload

# ============================================
# Payload CMS
# ============================================
# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=your-secret-here

# ============================================
# SvelteKit
# ============================================
# Public URL where the site will be accessed
ORIGIN=http://localhost:3000
