# .env.example
# Copy to .env and fill in values

# ============================================
# PostgreSQL Database Connection
# ============================================
# For Coolify: Get DB_HOST from PostgreSQL resource's "PostgreSQL URL (internal)"
#   The hostname is the UUID container name (e.g., ws8ggkwkgw0kww8csgwgwkg)
#   Enable "Connect to Predefined Network" in Coolify Service Stack settings
# For local development: Use localhost (or host.docker.internal for Docker containers)
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=change-me-in-production
DB_NAME=payload
DB_PORT=5432
# DATABASE_URL is constructed by docker-compose.yml from the above variables
# For local Payload CLI usage, construct manually: postgres://user:password@host:port/database
DATABASE_URL=postgres://postgres:change-me-in-production@localhost:5432/payload

# ============================================
# Payload CMS
# ============================================
# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=your-secret-here

# ============================================
# SvelteKit
# ============================================
# Public URL where the site will be accessed
ORIGIN=http://localhost:5173
