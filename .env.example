# .env.example
# Copy to .env and fill in values

# ============================================
# PostgreSQL - Coolify Database Connection
# ============================================
# For Coolify deployments: Get DB_HOST from PostgreSQL resource's "PostgreSQL URL (internal)"
# The hostname is the UUID container name (e.g., ws8ggkwkgw0kww8csgwgwkg)
# Enable "Connect to Predefined Network" in Coolify Service Stack settings
DB_HOST=ws8ggkwkgw0kww8csgwgwkg
DB_PASSWORD=your-postgres-password

# ============================================
# PostgreSQL - Local Development
# ============================================
# For local development: Use localhost or host.docker.internal for Docker containers
POSTGRES_USER=payload
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=payload
POSTGRES_PORT=5432
DATABASE_URL=postgres://payload:change-me-in-production@localhost:5432/payload

# ============================================
# Payload CMS
# ============================================
# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=your-secret-here

# ============================================
# SvelteKit
# ============================================
# Public URL where the site will be accessed
ORIGIN=http://localhost:5173
